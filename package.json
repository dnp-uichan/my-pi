{
	"name": "@jonghakseo/my-pi",
	"version": "0.1.1",
	"description": "A personal AI operating system built on pi — 10 agents, local/npm extensions, 8 themes",
	"keywords": [
		"pi-package"
	],
	"files": [
		"agents/",
		"extensions/.gitignore",
		"extensions/AGENTS.md",
		"extensions/archive-to-html/",
		"extensions/bash-tool-override/",
		"extensions/biome.json",
		"extensions/bookmark/",
		"extensions/custom-style/",
		"extensions/debug-session/",
		"extensions/diff-overlay/",
		"extensions/dynamic-agents-md/",
		"extensions/edit-tool-override/",
		"extensions/files/",
		"extensions/footer/",
		"extensions/fork-panel/",
		"extensions/github-pr-merge/",
		"extensions/interactive-shell/",
		"extensions/notify/",
		"extensions/ollama-kimi-k2-6-cloud/",
		"extensions/package.json",
		"extensions/bun.lock",
		"extensions/pr-comments/",
		"extensions/pr-review-re-request/",
		"extensions/prompt-suggest-lite/",
		"extensions/read-tool-override/",
		"extensions/README.md",
		"extensions/theme-cycler/",
		"extensions/to-html/",
		"extensions/tool-group-renderer/",
		"extensions/tooling/",
		"extensions/tsconfig.json",
		"extensions/upload-image-url/",
		"extensions/usage-analytics/",
		"extensions/utils/",
		"extensions/working-text/",
		"extensions/worktree/",
		"!extensions/**/.env",
		"!extensions/prompt-suggest-lite/.data/",
		"!extensions/utils/coverage/",
		"skills/",
		".mise.toml",
		"themes/",
		"scripts/sync-agents.mjs",
		"scripts/validate-packlist.mjs",
		"docs/assets/",
		"custom-style.json",
		"prompt-suggest-lite.json",
		"INSTALL.md",
		"README.ko.md",
		"SYSTEM.md"
	],
	"license": "MIT",
	"author": "Jonghakseo",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jonghakseo/my-pi.git"
	},
	"scripts": {
		"sync-agents": "node scripts/sync-agents.mjs",
		"validate:packlist": "node scripts/validate-packlist.mjs",
		"prepublishOnly": "bun run validate:packlist",
		"test:sync-agents": "node --test scripts/sync-agents.test.mjs",
		"postinstall": "node scripts/sync-agents.mjs"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		],
		"themes": [
			"./themes"
		]
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.27.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"packageManager": "bun@1.3.11"
}
